{
  "name": "express-postgres-starter",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "build": "npm run migrate",
    "migrate": "node migrate.js",
    "courses:stats": "node scripts/refresh-courses.js --stats",
    "courses:refresh": "node scripts/refresh-courses.js --apply",
    "pdga:backfill": "node scripts/backfill-pdga-ids.js",
    "pdga:backfill:apply": "node scripts/backfill-pdga-ids.js --apply",
    "cap:sync": "npx cap sync",
    "capacitor:sync:after": "node scripts/ensure-android-permissions.js",
    "cap:android": "npx cap add android",
    "cap:ios": "npx cap add ios",
    "android:debug": "node scripts/ensure-android-permissions.js && cd android && ./gradlew assembleDebug",
    "android:bundle": "node scripts/ensure-android-permissions.js && cd android && ./gradlew bundleRelease",
    "android:release": "node scripts/bump-android-version.js && node scripts/ensure-android-permissions.js && cd android && ./gradlew clean bundleRelease",
    "ios:sync": "npx cap sync ios"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "express": "^4.18.2",
    "form-data": "^4.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "node-fetch": "^2.7.0",
    "openai": "^4.77.0",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/geolocation": "^6.0.2",
    "@capacitor/ios": "^6.2.0",
    "@capacitor/splash-screen": "^6.0.2",
    "sharp": "^0.33.5",
    "typescript": "^6.0.3"
  }
}
